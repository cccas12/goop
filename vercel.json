{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "data/waselha-db.json"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/uploads/(.*)", "destination": "/api/index.ts" },
    { "source": "/downloads/(.*)", "destination": "/api/index.ts" },
    { "source": "/customer/(.*)", "destination": "/customer/index.html" },
    { "source": "/customer", "destination": "/customer/index.html" },
    { "source": "/driver/(.*)", "destination": "/driver/index.html" },
    { "source": "/driver", "destination": "/driver/index.html" },
    { "source": "/manager/(.*)", "destination": "/manager/index.html" },
    { "source": "/manager", "destination": "/manager/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
